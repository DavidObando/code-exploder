<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\CodeExploder.Domain\CodeExploder.Domain.csproj" />
    <ProjectReference Include="..\CodeExploder.Llm\CodeExploder.Llm.csproj" />
    <ProjectReference Include="..\CodeExploder.Qa\CodeExploder.Qa.csproj" />
    <ProjectReference Include="..\CodeExploder.Storage\CodeExploder.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- Explicit pin: the transitive 2.0.0 carries GHSA-v5pm-xwqc-g5wc (NU1903 is an error here). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- The web UI (webui/dist, built by `npm run build`) ships inside the Gateway's wwwroot
       on publish. Absent a build (bare checkout), publish still succeeds — the SPA is
       simply not served and devs use the Vite dev server instead. -->
  <Target Name="IncludeWebUi" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <WebUiDist Include="..\..\webui\dist\**\*" />
      <ResolvedFileToPublish Include="@(WebUiDist)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
