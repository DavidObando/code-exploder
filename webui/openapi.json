{
  "openapi": "3.1.1",
  "info": {
    "title": "CodeExploder.Gateway | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/sessions": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SessionSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewSessionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{id}": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionSummary"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/sessions/{id}/analysis": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/config": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/system/status": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "CodeExploder.Gateway"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisSnapshot": {
        "required": [
          "status",
          "stages",
          "narration",
          "lastEventId"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "stages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StageInfo"
            }
          },
          "narration": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NarrationLine"
            }
          },
          "lastEventId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ConfigResponse": {
        "required": [
          "authMode"
        ],
        "type": "object",
        "properties": {
          "authMode": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "message"
        ],
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "name",
          "subject"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          }
        }
      },
      "NarrationLine": {
        "required": [
          "at",
          "text"
        ],
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "NewSessionRequest": {
        "required": [
          "url",
          "gitRef"
        ],
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "gitRef": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "QueueStatus": {
        "required": [
          "depth",
          "activeJobs"
        ],
        "type": "object",
        "properties": {
          "depth": {
            "type": "integer",
            "format": "int64"
          },
          "activeJobs": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "SessionProgress": {
        "required": [
          "completedSections",
          "totalSections"
        ],
        "type": "object",
        "properties": {
          "completedSections": {
            "type": "integer",
            "format": "int32"
          },
          "totalSections": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SessionSummary": {
        "required": [
          "id",
          "kind",
          "title",
          "repoOwner",
          "repoName",
          "prNumber",
          "status",
          "failureReason",
          "createdAt",
          "progress"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "repoOwner": {
            "type": "string"
          },
          "repoName": {
            "type": "string"
          },
          "prNumber": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "status": {
            "type": "string"
          },
          "failureReason": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "progress": {
            "$ref": "#/components/schemas/SessionProgress"
          }
        }
      },
      "StageInfo": {
        "required": [
          "key",
          "label",
          "state",
          "percent",
          "detail"
        ],
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "percent": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SystemStatusResponse": {
        "required": [
          "db",
          "queue"
        ],
        "type": "object",
        "properties": {
          "db": {
            "type": "boolean"
          },
          "queue": {
            "$ref": "#/components/schemas/QueueStatus"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "CodeExploder.Gateway"
    }
  ]
}